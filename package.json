{
  "name": "loyalty-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "node scripts/db-migrate.mjs deploy",
    "db:migrate:dev": "node scripts/db-migrate.mjs dev",
    "db:migrate:status": "node scripts/db-migrate.mjs status",
    "db:roles": "node scripts/db-roles.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:test:up": "docker compose up -d --wait test-db",
    "db:test:down": "docker compose down test-db",
    "worker": "node dist/worker/index.mjs",
    "worker:dev": "tsx watch src/worker/index.ts",
    "gate": "node scripts/gate.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.0.1",
    "next": "^16.3.4",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.3",
    "pg": "^8.23.0",
    "pg-boss": "^12.31.0",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "js-yaml": "^4.3.2",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.2",
    "defu": "^6.1.7",
    "browserslist": "^4.28.9",
    "js-yaml": "^4.3.2",
    "@humanfs/node": "^0.16.8",
    "@babel/core": "^7.29.6",
    "minimatch@^3.1.5": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@^10.2.4": {
      "brace-expansion": "^5.0.9"
    }
  }
}
