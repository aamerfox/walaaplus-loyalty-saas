// WalaaPlus foundation schema — Phase 0.
//
// Authoritative design: docs/PRODUCT-SPEC.md §3–§4.
//
// Rules encoded here and in prisma/migrations/*/migration.sql:
//  * Global User + per-business BusinessMembership. Never staff embedded in a business.
//  * Customer is a global phone identity; names live on CustomerBusinessProfile.
//  * ProgramTemplate = live presentation. ProgramVersion = immutable mechanics, pinned by cards.
//  * LoyaltyOperation is APPEND-ONLY; a PostgreSQL trigger rejects UPDATE/DELETE.
//  * Card balance columns are projections. The ledger is the source of truth.
//  * IdempotencyRecord owns idempotency, unique on (businessId, key).
//
// Constraints Prisma cannot express live in raw SQL inside the migration:
//  * exactly one ACTIVE ProgramVersion per template (partial unique index)
//  * exactly one default Location per business (partial unique index)
//  * append-only LoyaltyOperation (trigger)
//  * ProgramVersion mechanics frozen once not DRAFT (trigger)
// Integration tests assert every one of them exists.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum MembershipRole {
  OWNER
  MANAGER
  CASHIER
}

enum Permission {
  VIEW_DASHBOARD
  VIEW_TEMPLATES
  EDIT_TEMPLATES
  VIEW_CUSTOMERS
  EDIT_CUSTOMERS
  VIEW_OPERATIONS
  MAKE_ACCRUALS
  MAKE_REDEMPTIONS
  VIEW_LOCATIONS
  EDIT_LOCATIONS
  VIEW_STAFF
  EDIT_STAFF
  VIEW_PUSHES
  EDIT_PUSHES
  VIEW_SEGMENTS
  EDIT_SEGMENTS
  VIEW_INTEGRATIONS
  EDIT_INTEGRATIONS
  VIEW_BILLING
  EDIT_BILLING
  VIEW_AGENCY
  EDIT_AGENCY
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  PAUSED // blocks new enrollment; existing cards keep working
  ARCHIVED
}

enum ProgramVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// MVP program types. Later types are added by migration when their phase arrives.
enum CardType {
  STAMP
  POINTS
}

enum CardStatus {
  ISSUED
  ACTIVE
  PAUSED
  EXPIRED
  DELETED
}

enum DeviceChannel {
  UNKNOWN
  PWA
  APPLE_WALLET
  GOOGLE_WALLET
}

enum OperationKind {
  CARD_ISSUED
  WELCOME_BONUS
  BIRTHDAY_BONUS
  MANUAL_AWARD
  VISIT_AWARD
  PURCHASE_AWARD
  STAMP_CONVERTED
  REWARD_EARNED
  REWARD_REDEEMED
  BALANCE_REDEEMED
  BALANCE_EXPIRED
  IMPORT_ADJUSTMENT
  REVERSAL
  REFERRAL_BONUS
  PROMOTION_REDEEMED
  INTEGRATION_AWARD
  INTEGRATION_REVERSAL
}

enum UnitType {
  STAMP
  POINT
  REWARD
  CASH
  VISIT
}

enum OperationSource {
  SCANNER
  DASHBOARD
  ENROLLMENT
  AUTOMATION
  IMPORT
  API
  SYSTEM
}

/// The only consent scope the product's data supports. The enrolment question is "I agree to
/// receive offers from this business" — a general marketing permission with no channel attached.
enum ConsentScope {
  MARKETING
}

/// UNKNOWN is a state, not a missing value: a profile claiming consent with no timestamp and no
/// text version answers neither "when" nor "to what", and is never eligible for marketing.
enum ConsentState {
  GRANTED
  WITHDRAWN
  UNKNOWN
}

/// How a consent record came to exist. No IMPORT and no API: every change has a person behind it.
enum ConsentCapture {
  ENROLMENT
  STAFF_UPDATE
}

/// The channel a campaign draft is INTENDED for. Nothing reads it to deliver anything.
enum CampaignChannel {
  PUSH
  SMS
  WHATSAPP
  EMAIL
}

/// Five states, none of which sends. There is deliberately no SENT, SCHEDULED or QUEUED here:
/// `PushMessageStatus` is the reserved delivery model and is separate and untouched.
///
/// APPROVED means a person decided about one exact revision and a snapshot was taken. It is not
/// permission to contact anybody — see `src/server/campaigns/delivery.ts`.
enum CampaignState {
  DRAFT
  IN_REVIEW
  APPROVED
  WITHDRAWN
  ARCHIVED
}

/// A decision is one of two verbs. There is no REJECT: an unwanted campaign goes back to draft.
enum CampaignDecision {
  APPROVED
  WITHDRAWN
}

enum PushMessageKind {
  MANUAL
  TRANSACTIONAL
  AUTOMATION
}

enum PushMessageStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum PushDeliveryStatus {
  PENDING
  SENT
  FAILED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity and tenancy
// ─────────────────────────────────────────────────────────────────────────────

/// Global merchant-side identity. Roles live on BusinessMembership, never here.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  platformRole String   @default("USER") // reserved: SUPER_ADMIN in a later phase
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       BusinessMembership[]
  operations        LoyaltyOperation[]         @relation("OperationActor")
  auditLogs         AuditLog[]                 @relation("AuditActor")
  pushMessages      PushMessage[]              @relation("PushAuthor")
  segments          CustomerSegment[]          @relation("SegmentAuthor")
  consentRecords    ConsentRecord[]            @relation("ConsentActor")
  campaigns         Campaign[]                 @relation("CampaignAuthor")
  campaignRevisions CampaignRevision[]         @relation("RevisionAuthor")
  campaignApprovals CampaignApproval[]         @relation("ApprovalDecider")
  shareLinks        CardShareLink[]            @relation("ShareLinkIssuer")
  referralsRecorded ReferralAttribution[]      @relation("ReferralRecorder")
  audienceSnapshots CampaignAudienceSnapshot[] @relation("SnapshotAuthor")
}

model Business {
  id            String   @id @default(uuid())
  agencyId      String? // reserved for Phase 5; no relation yet
  name          String
  legalName     String?
  phone         String?
  email         String?
  currency      String   @default("SYP") // ISO 4217; all amounts are integer minor units
  defaultLocale String   @default("ar")
  timezone      String   @default("Asia/Damascus") // IANA; day boundaries for limits and birthdays
  logoUrl       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships        BusinessMembership[]
  locations          Location[]
  templates          ProgramTemplate[]
  customerProfiles   CustomerBusinessProfile[]
  cards              CustomerCard[]
  operations         LoyaltyOperation[]
  idempotencyRecords IdempotencyRecord[]
  auditLogs          AuditLog[]
  segments           CustomerSegment[]
  consentRecords     ConsentRecord[]
  campaigns          Campaign[]
  campaignApprovals  CampaignApproval[]
  audienceSnapshots  CampaignAudienceSnapshot[]
  cardShareLinks     CardShareLink[]
  referrals          ReferralAttribution[]
  pushMessages       PushMessage[]
  pushSubscriptions  PushSubscription[]
}

/// A user's role inside one business. Resolved from the database on EVERY request.
model BusinessMembership {
  id          String         @id @default(uuid())
  businessId  String
  userId      String
  role        MembershipRole
  permissions Permission[]   @default([])
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  business  Business        @relation(fields: [businessId], references: [id])
  user      User            @relation(fields: [userId], references: [id])
  locations StaffLocation[]

  @@unique([businessId, userId])
  @@index([userId])
}

/// Which locations a membership may operate at. Empty = no location restriction (owners/managers).
model StaffLocation {
  membershipId String
  locationId   String
  createdAt    DateTime @default(now())

  membership BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location   Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([membershipId, locationId])
  @@index([locationId])
}

/// Every business has exactly one default "Main" location, created atomically at registration.
model Location {
  id         String   @id @default(uuid())
  businessId String
  name       String
  address    String?
  latitude   Decimal? @db.Decimal(9, 6) // reserved for geo-push
  longitude  Decimal? @db.Decimal(9, 6)
  isDefault  Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business           @relation(fields: [businessId], references: [id])
  staff      StaffLocation[]
  operations LoyaltyOperation[]

  @@index([businessId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Customers
// ─────────────────────────────────────────────────────────────────────────────

/// Global person identity keyed by normalized phone. No names here: those are per business.
model Customer {
  id              String    @id @default(uuid())
  normalizedPhone String    @unique // E.164 canonical form
  email           String?
  birthDate       DateTime? @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profiles   CustomerBusinessProfile[]
  operations LoyaltyOperation[]
}

/// The tenant-scoped view of a customer. Business A never sees Business B's profile.
model CustomerBusinessProfile {
  id                     String    @id @default(uuid())
  businessId             String
  customerId             String
  firstName              String?
  lastName               String?
  marketingConsent       Boolean   @default(false)
  privacyConsentAt       DateTime?
  consentTextVersion     String?
  customFields           Json?
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  referrerCustomerCardId String? // reserved for referrals (Phase 3a)
  firstSeenAt            DateTime  @default(now())
  lastSeenAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  business             Business                 @relation(fields: [businessId], references: [id])
  customer             Customer                 @relation(fields: [customerId], references: [id])
  cards                CustomerCard[]
  operations           LoyaltyOperation[]
  consentRecords       ConsentRecord[]
  audienceMemberships  CampaignAudienceMember[]
  referralAttributions ReferralAttribution[]

  @@unique([businessId, customerId])
  @@index([businessId, lastSeenAt])
  // The scanner's phone lookup arrives here through Customer (Phase 1a finding M-4).
  @@index([customerId])
  // The customer list pages WHERE businessId ORDER BY id (Phase 1a finding M-5).
  @@index([businessId, id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Programs: live presentation vs pinned mechanics
// ─────────────────────────────────────────────────────────────────────────────

/// Live, always-editable presentation and legal content. cardType locks at first activation (service rule).
model ProgramTemplate {
  id               String         @id @default(uuid())
  businessId       String
  name             String
  status           TemplateStatus @default(DRAFT)
  cardType         CardType
  defaultLocale    String         @default("ar")
  livePresentation Json           @default("{}") // logo, colours, labels, links
  liveLegal        Json           @default("{}") // terms, privacy, consent text
  liveIssuer       Json           @default("{}") // issuer name/email/phone
  livePlatform     Json           @default("{}") // pwa/apple/google toggles, enrollment page
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  business     Business           @relation(fields: [businessId], references: [id])
  versions     ProgramVersion[]
  cards        CustomerCard[]
  utmLinks     UtmSourceLink[]
  operations   LoyaltyOperation[]
  pushMessages PushMessage[]

  @@index([businessId, status])
}

/// Immutable mechanics. Exactly one ACTIVE per template (partial unique index in SQL).
/// A trigger rejects changes to `mechanics` once status leaves DRAFT, and rejects deletion of non-DRAFT rows.
model ProgramVersion {
  id            String               @id @default(uuid())
  templateId    String
  versionNumber Int
  status        ProgramVersionStatus @default(DRAFT)
  mechanics     Json                 @default("{}") // earn rules, thresholds, limits, expiry, countRewardRedemptionAsVisit
  createdAt     DateTime             @default(now())
  activatedAt   DateTime?
  /// When this version stopped being the live one. NULL on a DRAFT, on the ACTIVE version, and on
  /// anything retired before the column existed - which is not backfilled, because a fabricated
  /// timestamp shown to a merchant is worse than an honest blank.
  retiredAt     DateTime?

  template    ProgramTemplate    @relation(fields: [templateId], references: [id])
  rewardTiers RewardTier[]
  cards       CustomerCard[]
  operations  LoyaltyOperation[]
  // Also, in SQL: one ACTIVE and one DRAFT per template, as partial unique indexes Prisma cannot
  // express. See prisma/migrations/*/migration.sql.

  @@unique([templateId, versionNumber])
}

/// Reward tiers are rows, not JSON: the ledger references them by id.
model RewardTier {
  id               String   @id @default(uuid())
  programVersionId String
  name             String
  description      String?
  requiredPoints   Int
  rewardValueMinor Int? // merchant cost/value, for ROI reporting
  usageLimit       Int?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  programVersion ProgramVersion     @relation(fields: [programVersionId], references: [id])
  operations     LoyaltyOperation[]

  // A customer picks a reward by name, and a redemption is read back by it. Two tiers with one
  // name in a version make both of those a guess.
  @@unique([programVersionId, name])
  @@index([programVersionId])
}

/// Named enrollment sources. Every template gets a default `direct` link; every card carries attribution.
model UtmSourceLink {
  id                           String   @id @default(uuid())
  templateId                   String
  name                         String
  /// High-entropy server-side attribution key. Since owner decision B7 it appears in NO QR and no
  /// URL: public self-enrollment is withdrawn, `/api/enroll` is a constant 410, and counter
  /// enrolment resolves this value from the staff member's own membership. Nothing returns it.
  publicToken                  String   @unique
  utmSource                    String
  utmMedium                    String?
  utmCampaign                  String?
  welcomeUnitQuantity          Int?
  welcomeBonusExpiresAfterDays Int?
  enrollmentTitle              String?
  enrollmentImageUrl           String?
  active                       Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  template ProgramTemplate @relation(fields: [templateId], references: [id])
  cards    CustomerCard[]

  // Many links may share a utmSource (two Instagram campaigns, two in-store table codes).
  // The human-facing NAME is unique per template; publicToken is globally unique above.
  @@unique([templateId, name])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cards and ledger
// ─────────────────────────────────────────────────────────────────────────────

/// One card per customer per program. Balance columns are PROJECTIONS of the ledger.
model CustomerCard {
  id                        String        @id @default(uuid())
  businessId                String
  templateId                String
  programVersionId          String // pinned forever; the engine reads mechanics from here
  customerBusinessProfileId String
  serialNumber              String        @unique
  qrToken                   String        @unique // opaque; never the card id or customer id
  shareToken                String        @unique // separate from qrToken; page access ≠ scan access
  status                    CardStatus    @default(ISSUED)
  deviceChannel             DeviceChannel @default(UNKNOWN)

  // Projections. Three are needed: a stamp card holds stamps AND unredeemed rewards.
  stampBalance     Int @default(0)
  pointBalance     Int @default(0)
  rewardBalance    Int @default(0)
  cashBalanceMinor Int @default(0) // reserved: gift/cashback
  visitBalance     Int @default(0) // reserved: multipass/membership

  issuedAt        DateTime  @default(now())
  firstOpenedAt   DateTime?
  lastOpenedAt    DateTime?
  pwaDetectedAt   DateTime? // best-effort telemetry: "opened as app", never "installed"
  expiresAt       DateTime?
  lastActivityAt  DateTime?
  utmSourceLinkId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business          Business                @relation(fields: [businessId], references: [id])
  template          ProgramTemplate         @relation(fields: [templateId], references: [id])
  programVersion    ProgramVersion          @relation(fields: [programVersionId], references: [id])
  profile           CustomerBusinessProfile @relation(fields: [customerBusinessProfileId], references: [id])
  utmSourceLink     UtmSourceLink?          @relation(fields: [utmSourceLinkId], references: [id])
  operations        LoyaltyOperation[]
  pushSubscriptions PushSubscription[]
  pushDeliveries    PushDelivery[]
  shareLinks        CardShareLink[]
  referredBy        ReferralAttribution[]   @relation("EnrolledCard")
  referralsGiven    ReferralAttribution[]   @relation("ReferringCard")

  @@unique([customerBusinessProfileId, templateId])
  @@index([businessId, status])
  @@index([templateId])
  // Cards issued in a date range: the dashboard's acquisition figure (Phase 1b).
  @@index([businessId, issuedAt])
}

/// A card's INVITATION capability: the link a wallet pass opens.
///
/// Drawn separately from `qrToken`, `shareToken`, the serial and the enrolment source, so holding
/// one never yields another. Only the SHA-256 digest is stored — the raw value exists in the
/// response that minted it and in the wallet pass built from it, and nothing reads it back.
///
/// Issue-once: DELETE and TRUNCATE are refused by trigger, and UPDATE may change `revokedAt` and
/// nothing else, once, from NULL. `scripts/db-roles.mjs` lists it under NO_DELETE_TABLES.
model CardShareLink {
  id             String    @id @default(uuid())
  businessId     String
  customerCardId String
  /// SHA-256 of the raw capability, lower-case hex.
  tokenDigest    String    @unique
  /// Which pass issuance minted this. A label for the audit trail, never a route to anything.
  issuedFor      String
  issuedAt       DateTime
  issuedByUserId String?
  /// NULL while live. Set once and never cleared.
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  business             Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  card                 CustomerCard          @relation(fields: [customerCardId], references: [id], onDelete: Restrict)
  issuedBy             User?                 @relation("ShareLinkIssuer", fields: [issuedByUserId], references: [id])
  referralAttributions ReferralAttribution[]

  @@index([businessId, issuedAt(sort: Desc)])
}

/// How an invitation reached the counter. One value, because one flow exists.
enum ReferralMethod {
  COUNTER_PRESENTED_INVITATION
}

/// What a row asserts: the record, or a later row withdrawing one.
enum ReferralEntry {
  ATTRIBUTED
  VOIDED
}

/// APPEND-ONLY. "This newly issued card was enrolled at a counter where a staff member saw a valid
/// invitation from that link."
///
/// An attribution, not a reward. There is no amount, no points, no expiry, no eligibility flag and
/// no campaign reference, because no referral reward policy exists (D15) and a column added in
/// anticipation of one would be a policy nobody decided, written into a schema.
///
/// Internal ids only. The referring side is a `CardShareLink` id — never the capability that was
/// presented and never its digest. No name, phone, serial, balance, URL or money is copied here.
///
/// Voiding writes a VOIDED row pointing at the attribution, exactly as a campaign withdrawal does.
/// Nothing is ever updated or deleted; `referral_attribution_append_only` refuses both.
model ReferralAttribution {
  id                      String         @id @default(uuid())
  businessId              String
  entry                   ReferralEntry
  /// The invitation presented, by row id. Never the capability, never its digest.
  referringShareLinkId    String
  /// The card that invitation belongs to, denormalised so a later revocation cannot change what
  /// this row says happened.
  referringCustomerCardId String
  enrolledCustomerCardId  String
  enrolledProfileId       String
  method                  ReferralMethod
  /// Set on a VOIDED row: which attribution it withdraws.
  voidsAttributionId      String?
  /// Free text from whoever voided one. Never a phone number, never a name.
  reason                  String?
  recordedAt              DateTime
  recordedByUserId        String?
  createdAt               DateTime       @default(now())

  business        Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  referringLink   CardShareLink           @relation(fields: [referringShareLinkId], references: [id], onDelete: Restrict)
  referringCard   CustomerCard            @relation("ReferringCard", fields: [referringCustomerCardId], references: [id], onDelete: Restrict)
  enrolledCard    CustomerCard            @relation("EnrolledCard", fields: [enrolledCustomerCardId], references: [id], onDelete: Restrict)
  enrolledProfile CustomerBusinessProfile @relation(fields: [enrolledProfileId], references: [id], onDelete: Restrict)
  voids           ReferralAttribution?    @relation("AttributionVoid", fields: [voidsAttributionId], references: [id], onDelete: Restrict)
  voidedBy        ReferralAttribution[]   @relation("AttributionVoid")
  recordedBy      User?                   @relation("ReferralRecorder", fields: [recordedByUserId], references: [id])

  @@index([businessId, recordedAt(sort: Desc)])
  @@index([referringShareLinkId])
}

/// APPEND-ONLY. UPDATE and DELETE are rejected by trigger `loyalty_operation_append_only`.
/// There is deliberately no updatedAt. Corrections are new rows referencing `reversalOfOperationId`.
model LoyaltyOperation {
  id                        String  @id @default(uuid())
  transactionGroupId        String // groups atomic rows (e.g. award + conversion + reward earned)
  businessId                String
  locationId                String
  customerId                String
  customerBusinessProfileId String
  customerCardId            String
  templateId                String
  programVersionId          String
  performedByUserId         String? // null for ENROLLMENT/SYSTEM/AUTOMATION
  rewardTierId              String?

  kind                  OperationKind
  unitType              UnitType
  quantity              Int // signed; negative = redemption/reversal/expiry
  purchaseAmountMinor   Int? // customer spend in this transaction
  monetaryDeltaMinor    Int? // money moved for cash-based programs (later)
  redemptionValueMinor  Int? // merchant cost of a redeemed reward
  balanceAfter          Int // projection snapshot for `unitType` after this row
  countsAsVisit         Boolean // frozen at write time; see PRODUCT-SPEC §5.4
  source                OperationSource
  comment               String? // internal, never shown to the customer
  reason                String? // required on reversals/corrections
  reversalOfOperationId String?
  externalProvider      String?
  externalEventId       String?
  createdAt             DateTime        @default(now())

  business       Business                @relation(fields: [businessId], references: [id])
  location       Location                @relation(fields: [locationId], references: [id])
  customer       Customer                @relation(fields: [customerId], references: [id])
  profile        CustomerBusinessProfile @relation(fields: [customerBusinessProfileId], references: [id])
  card           CustomerCard            @relation(fields: [customerCardId], references: [id])
  template       ProgramTemplate         @relation(fields: [templateId], references: [id])
  programVersion ProgramVersion          @relation(fields: [programVersionId], references: [id])
  performedBy    User?                   @relation("OperationActor", fields: [performedByUserId], references: [id])
  rewardTier     RewardTier?             @relation(fields: [rewardTierId], references: [id])
  reversalOf     LoyaltyOperation?       @relation("Reversal", fields: [reversalOfOperationId], references: [id])
  reversals      LoyaltyOperation[]      @relation("Reversal")

  @@unique([externalProvider, externalEventId])
  @@index([businessId, createdAt])
  @@index([customerCardId, createdAt])
  @@index([locationId, createdAt])
  @@index([customerBusinessProfileId, createdAt])
  @@index([transactionGroupId])
  // Per-program metrics over a date range (Phase 1b dashboard read models).
  @@index([businessId, templateId, createdAt])
}

/// Owns idempotency for every write that may be retried. Lives OUTSIDE the ledger because one
/// request can produce several ledger rows. Stores the response so a retry returns the original.
model IdempotencyRecord {
  id                 String   @id @default(uuid())
  businessId         String
  key                String
  payloadHash        String // sha256 of canonical JSON; same key + different hash = conflict
  transactionGroupId String?
  response           Json
  createdAt          DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, key])
  @@index([createdAt])
}

/// A saved, reusable customer selection. A DEFINITION, never a stored list of people: membership is
/// derived on read from the same cards and ledger every other screen uses, so a segment cannot go
/// stale and cannot become a second copy of anybody's personal data.
model CustomerSegment {
  id                String    @id @default(uuid())
  businessId        String
  name              String
  /// Lower-cased, whitespace-collapsed. Unique per business, enforced in SQL.
  normalizedName    String
  /// Validated against an allowlist of fields and operators before it is written. Never executed.
  definition        Json
  definitionVersion Int       @default(1)
  /// Archived, never deleted: a later phase's campaigns will reference a segment by id.
  archivedAt        DateTime?
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business          Business                   @relation(fields: [businessId], references: [id])
  createdBy         User?                      @relation("SegmentAuthor", fields: [createdByUserId], references: [id])
  campaigns         Campaign[]
  audienceSnapshots CampaignAudienceSnapshot[]

  @@unique([businessId, normalizedName])
  @@index([businessId, archivedAt])
}

/// APPEND-ONLY consent history. UPDATE, DELETE and TRUNCATE are rejected by trigger
/// `consent_record_append_only`, exactly as they are on the ledger.
///
/// The enrolment consent on `CustomerBusinessProfile` is the ORIGIN record and is never rewritten;
/// this table holds every change after it. Nothing was backfilled, because an enrolment taken
/// before the consent version was wired up has no timestamp, and inventing one is worse than an
/// honest gap. See `src/server/consent/consent.ts`.
model ConsentRecord {
  id                        String         @id @default(uuid())
  businessId                String
  customerBusinessProfileId String
  scope                     ConsentScope
  state                     ConsentState
  /// What the state was immediately before this row, so one row is a complete account of one change.
  previousState             ConsentState
  capturedVia               ConsentCapture
  /// The consent-text revision this refers to, when one applies. Null for a recorded withdrawal.
  policyVersion             String?
  /// When it happened, which is not always when the row was written.
  recordedAt                DateTime
  actorUserId               String?
  /// Free text from the merchant. Never a phone number, never a token.
  reason                    String?
  createdAt                 DateTime       @default(now())

  business Business                @relation(fields: [businessId], references: [id])
  profile  CustomerBusinessProfile @relation(fields: [customerBusinessProfileId], references: [id])
  actor    User?                   @relation("ConsentActor", fields: [actorUserId], references: [id])

  audienceMemberships CampaignAudienceMember[]

  @@index([customerBusinessProfileId, scope, recordedAt(sort: Desc)])
  @@index([businessId, recordedAt])
}

/// A campaign DRAFT. It cannot send, schedule or queue anything: `CampaignState` has no such value,
/// and no provider, worker or queue exists in this build.
model Campaign {
  id              String          @id @default(uuid())
  businessId      String
  name            String
  /// Lower-cased, whitespace-collapsed. Unique per business, enforced in SQL.
  normalizedName  String
  locale          String
  channel         CampaignChannel
  state           CampaignState   @default(DRAFT)
  /// A REFERENCE to a live segment definition, never a copy of whom it matched.
  segmentId       String?
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  /// Which revision the current approval covers, or null. Derivable from CampaignApproval; kept
  /// here so the drafts list answers "is what I am looking at what was approved" without a
  /// correlated subquery per row. Cleared in the same transaction that invalidates an approval.
  approvedRevisionNumber Int?
  approvedSnapshotId     String?
  approvedAt             DateTime?

  business         Business                   @relation(fields: [businessId], references: [id])
  segment          CustomerSegment?           @relation(fields: [segmentId], references: [id], onDelete: Restrict)
  createdBy        User?                      @relation("CampaignAuthor", fields: [createdByUserId], references: [id])
  revisions        CampaignRevision[]
  approvals        CampaignApproval[]
  snapshots        CampaignAudienceSnapshot[]
  approvedSnapshot CampaignAudienceSnapshot?  @relation("CampaignApprovedSnapshot", fields: [approvedSnapshotId], references: [id], onDelete: Restrict)

  @@unique([businessId, normalizedName])
  @@index([businessId, archivedAt])
}

/// APPEND-ONLY. Every edit to a draft writes a new revision; `campaign_revision_append_only`
/// rejects UPDATE, DELETE and TRUNCATE.
model CampaignRevision {
  id              String   @id @default(uuid())
  campaignId      String
  revisionNumber  Int
  subject         String?
  body            String
  createdByUserId String?
  createdAt       DateTime @default(now())

  campaign  Campaign                   @relation(fields: [campaignId], references: [id])
  createdBy User?                      @relation("RevisionAuthor", fields: [createdByUserId], references: [id])
  approvals CampaignApproval[]
  snapshots CampaignAudienceSnapshot[]

  @@unique([campaignId, revisionNumber])
}

/// APPEND-ONLY. The record that a person decided something about one exact revision.
///
/// An approval that can be edited afterwards is a label, not a decision, so
/// `campaign_approval_append_only` rejects UPDATE, DELETE and TRUNCATE and the runtime role holds
/// only SELECT and INSERT.
model CampaignApproval {
  id                  String           @id @default(uuid())
  businessId          String
  campaignId          String
  /// The exact revision decided about. Approval never covers "the campaign".
  campaignRevisionId  String
  revisionNumber      Int
  decision            CampaignDecision
  /// The channel the approver was told this was for, declared at the decision rather than read
  /// from the draft afterwards.
  intendedChannel     CampaignChannel
  audienceSnapshotId  String?
  /// Which approval a withdrawal takes back. Null on an approval.
  withdrawsApprovalId String?
  decidedByUserId     String?
  decidedAt           DateTime
  /// Free text from the approver. Never a phone number, a customer name or a token.
  note                String?
  createdAt           DateTime         @default(now())

  business    Business                  @relation(fields: [businessId], references: [id])
  campaign    Campaign                  @relation(fields: [campaignId], references: [id])
  revision    CampaignRevision          @relation(fields: [campaignRevisionId], references: [id])
  snapshot    CampaignAudienceSnapshot? @relation(fields: [audienceSnapshotId], references: [id], onDelete: Restrict)
  withdraws   CampaignApproval?         @relation("ApprovalWithdrawal", fields: [withdrawsApprovalId], references: [id], onDelete: Restrict)
  withdrawnBy CampaignApproval[]        @relation("ApprovalWithdrawal")
  decidedBy   User?                     @relation("ApprovalDecider", fields: [decidedByUserId], references: [id])

  @@index([campaignId, decidedAt(sort: Desc)])
  @@index([businessId, decidedAt(sort: Desc)])
}

/// APPEND-ONLY. The audience as it was at the instant of a decision.
///
/// A segment is a live definition and its membership moves; a decision has to keep meaning what it
/// meant. This is the only place in the product where audience membership is stored at all.
model CampaignAudienceSnapshot {
  id                 String   @id @default(uuid())
  businessId         String
  campaignId         String
  campaignRevisionId String
  segmentId          String
  /// The segment's name at the moment of the snapshot: a business's own label, not customer data.
  segmentName        String
  takenAt            DateTime
  matchedCount       Int
  /// The number of CampaignAudienceMember rows, stored so the header alone is a complete answer.
  eligibleCount      Int
  /// Exclusions as COUNTS ONLY. No row is written for an excluded customer.
  unknownCount       Int
  withdrawnCount     Int
  takenByUserId      String?
  createdAt          DateTime @default(now())

  business         Business                 @relation(fields: [businessId], references: [id])
  campaign         Campaign                 @relation(fields: [campaignId], references: [id])
  revision         CampaignRevision         @relation(fields: [campaignRevisionId], references: [id])
  segment          CustomerSegment          @relation(fields: [segmentId], references: [id])
  takenBy          User?                    @relation("SnapshotAuthor", fields: [takenByUserId], references: [id])
  members          CampaignAudienceMember[]
  approvals        CampaignApproval[]
  approvedCampaign Campaign[]               @relation("CampaignApprovedSnapshot")

  @@index([campaignId, takenAt(sort: Desc)])
  @@index([businessId])
}

/// APPEND-ONLY. One row per customer who MAY be contacted, and the smallest row that can be.
///
/// Deliberately absent: phone, name, email, card id, serial, card URL, QR token, share token,
/// source token, and any rendered message. A future delivery phase resolves a contact detail from
/// the profile reference under its own authorization; it does not inherit a contact list.
model CampaignAudienceMember {
  id                        String       @id @default(uuid())
  snapshotId                String
  customerBusinessProfileId String
  /// Observed at the instant of the snapshot, so a later rule change cannot reinterpret it.
  consentState              ConsentState
  /// The record that decided it. Null means the permission came from the enrolment answer itself.
  consentRecordId           String?
  createdAt                 DateTime     @default(now())

  snapshot      CampaignAudienceSnapshot @relation(fields: [snapshotId], references: [id])
  profile       CustomerBusinessProfile  @relation(fields: [customerBusinessProfileId], references: [id])
  consentRecord ConsentRecord?           @relation(fields: [consentRecordId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, customerBusinessProfileId])
  @@index([snapshotId])
}

/// Non-ledger security and business events: registration, membership changes, template activation,
/// restore-link generation, exports.
model AuditLog {
  id          String   @id @default(uuid())
  businessId  String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id])
  actor    User?     @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Push (schema reservation; delivery logic arrives in Phase 1.5)
// ─────────────────────────────────────────────────────────────────────────────

/// One per service-worker registration, i.e. per card (cards are registered with per-card scope).
model PushSubscription {
  id             String   @id @default(uuid())
  businessId     String
  customerCardId String
  endpoint       String   @unique
  p256dh         String
  auth           String
  userAgent      String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business   Business       @relation(fields: [businessId], references: [id])
  card       CustomerCard   @relation(fields: [customerCardId], references: [id])
  deliveries PushDelivery[]

  @@index([customerCardId])
}

/// One campaign or single message. Recipients are PushDelivery rows.
model PushMessage {
  id              String            @id @default(uuid())
  businessId      String
  templateId      String?
  title           String
  body            String
  targetUrl       String?
  kind            PushMessageKind
  status          PushMessageStatus @default(DRAFT)
  scheduledAt     DateTime?
  createdByUserId String?
  createdAt       DateTime          @default(now())

  business   Business         @relation(fields: [businessId], references: [id])
  template   ProgramTemplate? @relation(fields: [templateId], references: [id])
  createdBy  User?            @relation("PushAuthor", fields: [createdByUserId], references: [id])
  deliveries PushDelivery[]

  @@index([businessId, createdAt])
}

/// One row per recipient subscription per message, carrying its own status and retries.
model PushDelivery {
  id                 String             @id @default(uuid())
  pushMessageId      String
  pushSubscriptionId String
  customerCardId     String
  status             PushDeliveryStatus @default(PENDING)
  attemptCount       Int                @default(0)
  providerStatusCode Int?
  failureReason      String?
  sentAt             DateTime?
  failedAt           DateTime?
  createdAt          DateTime           @default(now())

  message      PushMessage      @relation(fields: [pushMessageId], references: [id])
  subscription PushSubscription @relation(fields: [pushSubscriptionId], references: [id])
  card         CustomerCard     @relation(fields: [customerCardId], references: [id])

  @@index([pushMessageId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Authentication abuse control
// ─────────────────────────────────────────────────────────────────────────────

/// One fixed window per (scope, keyHash) for authentication rate limiting.
///
/// Enforcement is in the DATABASE, not in process memory, so the limit holds across web
/// processes and restarts (src/server/security/rate-limit.ts). `keyHash` is an HMAC of the
/// normalised identifier — never a plain email address or raw IP — so the table cannot be
/// mined for who tried to sign in. Rows expire and are pruned; `expiresAt` is indexed for it.
model AuthRateLimit {
  id            String   @id @default(uuid())
  scope         String // e.g. auth.signin.email, auth.register.ip
  keyHash       String // HMAC-SHA256 of the normalised identifier, hex
  attempts      Int      @default(1)
  windowStart   DateTime @default(now())
  expiresAt     DateTime
  lastAttemptAt DateTime @default(now())

  @@unique([scope, keyHash])
  @@index([expiresAt])
}
