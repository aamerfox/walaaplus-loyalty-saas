{
  "compilerOptions": {
    // ES2020 for BIGINT LITERALS (`0n`). Phase 4 money is integer minor units in `bigint`, because
    // `number` is a float and SYP amounts pass 2^53. This file sets `noEmit`, so `target` governs
    // only what TypeScript ACCEPTS here - Next/SWC transpile the app against their own browser
    // targets and are unaffected by this line.
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
