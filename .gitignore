# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# build / lint artifacts (never commit: they embed local absolute paths)
*.log
build.log
build_error.log
lint_errors.txt

# test output
/playwright-results/
/playwright-report/
/test-results/

# scratch / temporary scripts
tmp_*.js
tmp_*.ts

# env files. The sanitized .env.example template IS tracked on purpose.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
