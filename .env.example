# WalaaPlus environment template
#
# Copy to `.env` for local development and fill in values. `.env` is git-ignored.
# This file contains VARIABLE NAMES ONLY. Never put a real value or credential here.
# Safe development defaults are described in comments, not assigned.
#
# Production and staging values are provisioned by the owner only (see docs/DECISIONS-REQUIRED.md B5).

# ---------------------------------------------------------------------------
# Runtime (web + worker). Validated at startup by src/server/env.ts; the process
# refuses to start if a required variable is missing. Names are reported, never values.
# ---------------------------------------------------------------------------

# Required. PostgreSQL connection string for the application database.
# Dev default shape: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?schema=public
DATABASE_URL=

# Required. NextAuth session signing secret, minimum 32 characters.
# Generate with: openssl rand -base64 48
# NEVER reuse a value that has appeared in git history.
NEXTAUTH_SECRET=

# Required. Public origin of the web app, e.g. http://localhost:3000 in development.
NEXTAUTH_URL=

# Optional. Same as NEXTAUTH_URL; exposed to the browser for absolute links.
NEXT_PUBLIC_APP_URL=

# Optional. Port the worker's health endpoint listens on. Dev default: 8081
WORKER_HEALTH_PORT=

# ---------------------------------------------------------------------------
# Docker Compose (local only). Read by docker-compose.yml; no literal credentials are committed.
# ---------------------------------------------------------------------------

# Dev default: walaaplus
POSTGRES_USER=
# Dev only; choose any local value. Not used outside your machine.
POSTGRES_PASSWORD=
# Dev default: loyalty
POSTGRES_DB=
# Dev default: 5433 (5432 is often taken by other local databases)
POSTGRES_PORT=

# ---------------------------------------------------------------------------
# Tests. Integration tests need a REAL, DISPOSABLE PostgreSQL. Never point this at a shared database:
# the test harness truncates every table.
# ---------------------------------------------------------------------------

# Dev default port for the disposable test database container: 5435
TEST_POSTGRES_PORT=
# Dev default shape: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<TEST_POSTGRES_PORT>/loyalty_test?schema=public
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Development seed (`npm run db:seed`). Optional. Refused when NODE_ENV=production.
# If SEED_OWNER_PASSWORD is unset a random one is generated and printed once.
# ---------------------------------------------------------------------------
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
