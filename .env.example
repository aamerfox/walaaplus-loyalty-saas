# WalaaPlus environment template
#
# Copy to `.env` for local development and fill in values. `.env` is git-ignored.
# This file contains VARIABLE NAMES ONLY. Never put a real value or credential here.
# Safe development defaults are described in comments, not assigned.
#
# Production and staging values are provisioned by the owner only (see docs/DECISIONS-REQUIRED.md B5).

# ---------------------------------------------------------------------------
# Runtime (web + worker). Validated at startup by src/server/env.ts; the process
# refuses to start if a required variable is missing. Names are reported, never values.
# ---------------------------------------------------------------------------

# Required. RUNTIME connection string for web and worker. MUST use the restricted application
# role (APP_DB_USER, default walaaplus_app), never the owner/migrator role. `npm run db:roles`
# creates this role from the name and password in this URL.
# Dev default shape: postgresql://walaaplus_app:<APP_DB_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?schema=public
DATABASE_URL=

# Required for `npm run db:migrate` and `npm run db:roles` (never read by web or worker).
# Owner/migrator role: owns every table, applies migrations, grants the runtime role.
# Dev default shape: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?schema=public
MIGRATE_DATABASE_URL=

# Required. NextAuth session signing secret, minimum 32 characters.
# Generate with: openssl rand -base64 48
# NEVER reuse a value that has appeared in git history.
NEXTAUTH_SECRET=

# Required. Public origin of the web app, e.g. http://localhost:3000 in development.
NEXTAUTH_URL=

# Optional, default false. Whether X-Forwarded-For / X-Real-IP may be believed. Accepts exactly
# "true" or "false". Set it to true ONLY when every request passes through a proxy that REPLACES
# those headers (docker-compose.yml's `proxy` service does) AND the app's own port is not
# published. With it false the app reports no client address at all, which is deliberate: a
# forgeable address turns a per-address rate limit into no limit. See PHASE-0-IMPLEMENTATION.md §9.
TRUST_PROXY_HEADERS=

# Optional. Same as NEXTAUTH_URL; exposed to the browser for absolute links.
NEXT_PUBLIC_APP_URL=

# Optional. Port the worker's health endpoint listens on INSIDE its container. Dev default: 8081.
# Compose does not publish it: the orchestrator probes it from inside. Read it by hand with
#   docker compose exec worker wget -qO- http://localhost:8081/health
WORKER_HEALTH_PORT=

# ---------------------------------------------------------------------------
# Authentication rate limiting (src/server/security/rate-limit.ts). Enforced in PostgreSQL,
# so the limit survives restarts and holds across web processes. All optional: the defaults
# below are production-usable. A value is validated, so a typo fails startup rather than
# silently disabling the limit (0 is refused; there is no "off" switch).
# ---------------------------------------------------------------------------

# Registration attempts per client address per window. Default: 10
AUTH_RATE_LIMIT_REGISTER_MAX=
# Registration window, seconds. Default: 900
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=
# Sign-in attempts per identifier AND per client address per window. Default: 10
AUTH_RATE_LIMIT_SIGNIN_MAX=
# Sign-in window, seconds. Default: 900
AUTH_RATE_LIMIT_SIGNIN_WINDOW_SECONDS=
# Optional pepper (>= 16 chars) for the keyed hash of rate-limit identifiers. When unset, one is
# derived from NEXTAUTH_SECRET. Set it to rotate the two independently; rotating either just
# starts fresh windows. Generate with: openssl rand -base64 32
AUTH_RATE_LIMIT_PEPPER=

# ---------------------------------------------------------------------------
# Docker Compose (local only). Read by docker-compose.yml; no literal credentials are committed.
# ---------------------------------------------------------------------------

# Dev default: walaaplus
POSTGRES_USER=
# Dev only; choose any local value, but make it URL-SAFE: this password is interpolated into
# MIGRATE_DATABASE_URL by docker-compose.yml, and Compose substitutes it verbatim. A `/` ends the
# URL's authority early and the connection string stops parsing. `openssl rand -hex 32` is safe;
# `openssl rand -base64 24` contains `/` about a third of the time.
POSTGRES_PASSWORD=
# Dev default: loyalty
POSTGRES_DB=
# Dev default: 5433 (5432 is often taken by other local databases). Compose binds this to
# 127.0.0.1 ONLY, so the database is never published to a public interface.
POSTGRES_PORT=

# Host port the reverse proxy publishes for `docker compose --profile app`. Dev default: 8080.
# This is the ONLY public binding in the stack: `web` and `worker` are container-only and the two
# databases are bound to 127.0.0.1. Reach the app through this port only.
WEB_PORT=

# Runtime role used by the web/worker containers (docker-compose.yml builds DATABASE_URL from these).
# Must match the role and password inside DATABASE_URL above. Dev default name: walaaplus_app
APP_DB_USER=
# Dev only; choose any local value. Created/rotated by `npm run db:roles`. URL-safe, for the same
# reason as POSTGRES_PASSWORD above.
APP_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Tests. Integration tests need a REAL, DISPOSABLE PostgreSQL. Never point this at a shared database:
# the test harness truncates every table.
# ---------------------------------------------------------------------------

# Dev default port for the disposable test database container: 5435. Bound to 127.0.0.1 only.
TEST_POSTGRES_PORT=
# Migrator/owner role on the TEST database. The harness applies migrations and creates the runtime role with it.
# Dev default shape: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<TEST_POSTGRES_PORT>/loyalty_test?schema=public
TEST_MIGRATE_DATABASE_URL=
# RUNTIME role on the TEST database: every integration test connects as this restricted role, like web and worker.
# The role is created by the harness from this URL's name and password. Must differ from the migrator role.
# Dev default shape: postgresql://walaaplus_app:<APP_DB_PASSWORD>@localhost:<TEST_POSTGRES_PORT>/loyalty_test?schema=public
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Development seed (`npm run db:seed`). Optional. Refused when NODE_ENV=production.
# If SEED_OWNER_PASSWORD is unset a random one is generated and printed once.
# ---------------------------------------------------------------------------
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
