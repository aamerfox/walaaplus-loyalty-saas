# WalaaPlus STAGING environment template
#
# Copy to `.env.staging` ON THE STAGING SERVER and fill in values there. `.env.staging` is
# git-ignored; this template is tracked and contains VARIABLE NAMES ONLY.
#
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --build
#
# `--env-file` is not optional. Compose loads `.env` by default, and `.env` is the LOCAL
# development file: without the flag a staging stack would silently come up on development
# values. The full procedure is docs/STAGING-RUNBOOK.md.
#
# NEVER put a real value in this file, never commit `.env.staging`, and never paste a secret into
# a chat, an issue, an evidence file or a commit message. Generate secrets ON the server:
#
#   openssl rand -base64 48     # NEXTAUTH_SECRET
#   openssl rand -base64 24     # POSTGRES_PASSWORD, APP_DB_PASSWORD (one each, never the same)
#
# Ownership of these values is owner decision B5. The agent supplies names and commands only.
#
# File permissions, on the server, before the first `up`:
#   chmod 600 .env.staging && chown root:root .env.staging

# ---------------------------------------------------------------------------
# Public identity. Neither is a secret; both must be correct before the first start, because
# Caddy requests a certificate for WALAAPLUS_DOMAIN the moment it boots.
# ---------------------------------------------------------------------------

# Owner decision B2. The hostname the certificate is issued for, WITHOUT a scheme or a path.
# An A record for it must already resolve to this server's public address. Example shape:
# staging.<a-domain-you-control>.<tld>
WALAAPLUS_DOMAIN=

# Owner decision B3. The address Let's Encrypt sends expiry and problem notices to. A real
# mailbox someone reads - it is the warning you get when renewal has been failing for a week.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Database. TWO roles, two passwords, never the same value (docs/PHASE-0-IMPLEMENTATION.md §4).
# Only the `migrate` service receives the owner role; web and worker receive the runtime role.
# ---------------------------------------------------------------------------

# Owner/migrator role. Owns every table, applies migrations, creates the runtime role.
POSTGRES_USER=
POSTGRES_PASSWORD=
# Database name. Leave blank to use the compose default `loyalty`.
POSTGRES_DB=

# Restricted runtime role used by web and worker. It can read and write application tables but
# can never update, delete or truncate the ledger and owns nothing in `public`.
# Leave APP_DB_USER blank to use the default name `walaaplus_app`.
APP_DB_USER=
# Created and rotated by the `migrate` service, which reads it from DATABASE_URL.
APP_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Application. Validated at startup by src/server/env.ts; the process refuses to start if one is
# missing, and reports variable NAMES only.
# ---------------------------------------------------------------------------

# NextAuth session signing secret, minimum 32 characters. Generate it on the server with
# `openssl rand -base64 48`. It must differ from the development value and from production's.
# A value that has ever appeared in git history is refused at startup by name-independent hash.
NEXTAUTH_SECRET=

# ---------------------------------------------------------------------------
# Set by docker-compose.staging.yml, NOT here. Listed so nobody adds them twice:
#
#   DATABASE_URL           built from APP_DB_USER / APP_DB_PASSWORD / POSTGRES_DB
#   MIGRATE_DATABASE_URL   built from POSTGRES_USER / POSTGRES_PASSWORD; `migrate` only
#   NEXTAUTH_URL           https://${WALAAPLUS_DOMAIN}
#   TRUST_PROXY_HEADERS    "true", valid only because the proxy replaces the header and the app
#                          publishes no port of its own
#   NODE_ENV               production
#   WORKER_HEALTH_PORT     8081, inside the worker container
#
# OPTIONAL tuning knobs (src/server/env.ts) have production-usable defaults and are deliberately
# NOT passed through, so an empty line in an env file cannot turn a rate limit into 0:
# AUTH_RATE_LIMIT_REGISTER_MAX, AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS, AUTH_RATE_LIMIT_SIGNIN_MAX,
# AUTH_RATE_LIMIT_SIGNIN_WINDOW_SECONDS, AUTH_RATE_LIMIT_PEPPER, ENROLL_RATE_LIMIT_IP_MAX,
# ENROLL_RATE_LIMIT_LINK_MAX, ENROLL_RATE_LIMIT_WINDOW_SECONDS.
# To change one, add it to the `web` service's `environment:` block with an explicit value.
#
# NOT USED BY THIS PRODUCT, in any environment: Stripe, Twilio, OneSignal, Apple Wallet, Google
# Wallet, SMTP. The stale `.env.production.example` in this repository predates the rebuild and
# names all of them; it is not the template for anything. See docs/STAGING-RUNBOOK.md §11.
# ---------------------------------------------------------------------------
